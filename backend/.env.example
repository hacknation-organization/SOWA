# Skopiuj do backend/.env i uzupełnij. Nie commituj prawdziwych kluczy.
# Domyślnie SQLite (plik backend/kompas.db). Postgres + pgvector z docker-compose:
# DATABASE_URL=postgresql+psycopg://kompas:kompas@localhost:5432/kompas
DATABASE_URL=sqlite:///./kompas.db
JWT_SECRET=zmien-mnie-na-losowy-ciag-min-32-znaki
GEMINI_API_KEY=
SEED_DEMO_DATA=true
